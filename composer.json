{
    "name": "inilim/didom",
    "description": "Simple and fast HTML parser",
    "type": "library",
    "keywords": [
        "didom",
        "parser",
        "html",
        "xml"
    ],
    "license": "MIT",
    "homepage": "https://github.com/Imangazaliev/DiDOM",
    "authors": [
        {
            "name": "Imangazaliev Muhammad",
            "email": "imangazalievm@gmail.com"
        }
    ],
    "scripts": {
        "tests": [
            "php vendor/bin/phpunit tests"
        ],
        "stan": [
            "php vendor/bin/phpstan analyze"
        ]
    },
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-iconv": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5",
        "inilim/tools": "^0.1.20261104"
    },
    "autoload": {
        "psr-4": {
            "DiDom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DiDom\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.99"
        }
    }
}